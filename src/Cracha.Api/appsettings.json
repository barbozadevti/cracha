{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Banco": {
    "Provedor": "Sqlite",
    "ConnectionString": "Data Source=cracha.db",
    "CriarExemplos": true
  },
  "Historico": {
    "Provedor": "Banco",
    "ConnectionString": "UseDevelopmentStorage=true",
    "Tabela": "FuncionarioLog"
  },
  "Fotos": {
    "Provedor": "Disco",
    "ConnectionString": "UseDevelopmentStorage=true",
    "Container": "fotos"
  },
  "Acesso": {
    "Demonstracao": true,
    "SenhaDemonstracao": "Cracha@2026"
  }
}
